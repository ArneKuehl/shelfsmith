{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-internal-toggle-devtools",
    "core:event:allow-listen",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-open",
    "store:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://0.0.0.0:*" },
        { "url": "http://192.168.*.*:*" },
        { "url": "http://10.*.*.*:*" },
        { "url": "http://172.*.*.*:*" },
        { "url": "http://*.local:*" },
        { "url": "http://*.lan:*" },
        { "url": "https://192.168.*.*:*" },
        { "url": "https://10.*.*.*:*" },
        { "url": "https://172.*.*.*:*" },
        { "url": "https://*.local:*" },
        { "url": "https://*.lan:*" },
        { "url": "https://www.googleapis.com/" },
        { "url": "https://openlibrary.org/" }
      ]
    }
  ]
}
